#time complexity O(logN) by using lower and upper bound binary search

def ind(a):
    x=int(input("Enter the element to be searched: "))
    low,high=0,len(a)-1
    first,last=-1,-1
    while low<=high:
        mid=(low+high)//2
        if a[mid]==x:
            first=mid
            high=mid-1
        elif a[mid]>x:
            high=mid-1
        else:
            low=mid+1

    low,high=0,len(a)-1
    while low<=high:
        mid=(low+high)//2
        if a[mid]==x:
            last=mid
            low=mid+1
        elif a[mid]>x:
            high=mid-1
        else:
            low=mid+1

    print("First occurrence: ",first)
    print("Last occurrence: ",last)

a=[1,2,3,3,4,4,8,8,8,8,9,10]
ind(a)
